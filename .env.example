# Copy to .env and fill in. Never commit .env.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Where each message is POSTed as JSON
FORWARD_URL=http://127.0.0.1:8000/discord

# Optional shared secret, sent as the X-Bridge-Secret header (the example receiver checks it)
FORWARD_SECRET=

# Optional: only forward from these channel IDs (comma-separated). Empty = all channels the bot can see.
# Threads are included when their parent channel is listed.
CHANNEL_IDS=

# Optional: only forward from these server IDs (comma-separated). Empty = all servers.
GUILD_IDS=

# Forward messages written by other bots too (default false)
INCLUDE_BOTS=false

# Delivery tuning
MAX_RETRIES=5
QUEUE_SIZE=1000
